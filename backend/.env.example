# Copy to .env  (never commit .env)
DATABASE_URL=postgresql+psycopg://studentwise:studentwise@localhost:5434/studentwise
TEST_DATABASE_URL=postgresql+psycopg://studentwise:studentwise@localhost:5434/studentwise_test

# Change this before anything is ever deployed
JWT_SECRET=dev-secret-change-me-before-deploying-anywhere
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Claude (optional). Used by the Ask screen (POST .../analytics/ask), receipt
# scanning (POST .../receipts/scan) and the money assistant (.../chat). Without a
# key those return 503 and the rest of the app is unaffected. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Which model each feature uses. Sonnet by default, for cost; set either to
# claude-opus-5 to trade money for accuracy.
# NL_QUERY_MODEL=claude-sonnet-5
# RECEIPT_OCR_MODEL=claude-sonnet-5
# CHAT_MODEL=claude-sonnet-5
# Optional dedicated read-only role for generated SQL (defence in depth).
# READONLY_DATABASE_URL=postgresql+psycopg://studentwise_readonly:readonly@localhost:5434/studentwise

# Bills from Gmail (optional). Without these the Gmail endpoints return 503 and
# the Settings screen says Gmail isn't set up. Setup: docs/gmail-setup.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud exactly.
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/gmail/callback
# FRONTEND_URL=http://localhost:5173
# Encrypts stored Gmail tokens. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=
# BILL_PARSER_MODEL=claude-sonnet-5

# Receipt images. Local disk in development; the directory is gitignored.
RECEIPT_STORAGE_DIR=var/receipts
RECEIPT_MAX_BYTES=5242880
